<Window x:Class="AirType.Views.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Confirm"
        Width="380" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Confirmation dialog"
        Style="{DynamicResource GlobalModalWindow}">

    <Border Style="{DynamicResource ModalCard}" Margin="20">
        <Grid>
            <!-- Close Button (X in corner) -->
            <Button x:Name="CloseButton"
                    Style="{DynamicResource ModalCloseButton}"
                    AutomationProperties.Name="Close confirmation dialog"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,14,0"
                    Click="Cancel_Click"
                    Panel.ZIndex="10"/>

            <!-- Content -->
            <StackPanel Margin="24">
                <!-- Icon (optional, shown for destructive actions) -->
                <Border x:Name="IconContainer"
                        Width="48" Height="48"
                        CornerRadius="24"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <materialDesign:PackIcon x:Name="DialogIcon"
                                             Width="24" Height="24"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock x:Name="TitleText"
                           Text="Confirm Action"
                           Style="{DynamicResource PageHeader}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Message -->
                <TextBlock x:Name="MessageText"
                           Text="Are you sure you want to proceed?"
                           Style="{DynamicResource BodyText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cancel Button (Secondary) -->
                    <Button Grid.Column="0"
                            x:Name="CancelButton"
                            Content="Cancel"
                            Style="{DynamicResource BaseButton}"
                            AutomationProperties.Name="Cancel confirmation"
                            Click="Cancel_Click"/>

                    <!-- Confirm Button (Primary or Danger) -->
                    <Button Grid.Column="2"
                            x:Name="ConfirmButton"
                            Content="Confirm"
                            Style="{DynamicResource PrimaryButton}"
                            AutomationProperties.Name="Confirm action"
                            Click="Confirm_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
