<Window x:Class="AirType.Views.NotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Notification"
        Width="380" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource GlobalModalWindow}">

    <Border Style="{DynamicResource ModalCard}" Margin="20">
        <Grid>
            <!-- Close Button (X in corner) -->
            <Button x:Name="CloseButton"
                    Style="{DynamicResource ModalCloseButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,14,0"
                    AutomationProperties.Name="Close notification"
                    Click="OK_Click"
                    Panel.ZIndex="10"/>

            <!-- Content -->
            <StackPanel Margin="24">
                <!-- Icon -->
                <Border x:Name="IconContainer"
                        Width="48" Height="48"
                        CornerRadius="24"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <materialDesign:PackIcon x:Name="DialogIcon"
                                             Width="24" Height="24"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock x:Name="TitleText"
                           Text="Notification"
                           Style="{DynamicResource PageHeader}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Message -->
                <TextBlock x:Name="MessageText"
                           Text="This is a notification message."
                           Style="{DynamicResource BodyText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- OK Button (centered, full width) -->
                <Button x:Name="OKButton"
                        Content="OK"
                        Style="{DynamicResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="OK"
                        Click="OK_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
