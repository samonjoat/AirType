<Window x:Class="AirType.Views.ModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Modal"
        Width="Auto" Height="Auto"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource GlobalModalWindow}">

    <Border Style="{DynamicResource ModalCard}" Margin="20">
        <Grid>
            <!-- Close Button (X in corner) - optional, controlled by ShowCloseButton -->
            <Button x:Name="CloseButton"
                    Style="{DynamicResource ModalCloseButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,14,0"
                    AutomationProperties.Name="Close dialog"
                    Click="CloseButton_Click"
                    Panel.ZIndex="10"/>

            <!-- Content Host -->
            <ContentPresenter x:Name="ContentHost" Margin="24"/>
        </Grid>
    </Border>
</Window>
