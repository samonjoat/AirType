<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AirType.Controls">

    <Style TargetType="{x:Type controls:LatencyChart}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LatencyChart}">
                    <Border Background="{DynamicResource BgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            Height="28">
                        <Grid x:Name="PART_LatencyGrid"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:WordActivityLineChart}">
        <Setter Property="Height" Value="108"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:WordActivityLineChart}">
                    <Canvas x:Name="PART_ChartCanvas"
                            Height="{TemplateBinding Height}"
                            Background="Transparent"
                            ClipToBounds="False"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
