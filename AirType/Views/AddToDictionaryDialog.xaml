<Window x:Class="AirType.Views.AddToDictionaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add to Dictionary"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Add corrections to dictionary dialog"
        Style="{DynamicResource GlobalModalWindow}">

    <!-- V2: Card Style Rows with Edit/Remove Icons -->
    <Border Style="{DynamicResource ModalCard}" Margin="20">
        <Grid>
            <!-- Close Button (X in corner) -->
            <Button Style="{DynamicResource ModalCloseButton}"
                    AutomationProperties.Name="Close add to dictionary dialog"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,14,0"
                    Click="Skip_Click"
                    Panel.ZIndex="10"/>

            <!-- Content -->
            <StackPanel Margin="24">
                <!-- Title -->
                <TextBlock Text="Correction Detected"
                           Style="{DynamicResource PageHeader}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <!-- Changes List (Card Style) -->
                <ItemsControl ItemsSource="{Binding Changes}"
                              AutomationProperties.Name="Detected corrections"
                              Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card Row Container -->
                            <Border Style="{DynamicResource DiffRowCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ===== NORMAL MODE DISPLAY ===== -->
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisConverter}}">

                                        <!-- For MODIFIED: Show red original with strikethrough -->
                                        <Border Style="{DynamicResource DiffTagOriginal}"
                                                Margin="0,0,10,0"
                                                Visibility="{Binding IsModified, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{Binding OriginalText}"
                                                       Style="{DynamicResource DiffTextOriginal}"/>
                                        </Border>

                                        <!-- For ADDED: Show grey "NEW" tag -->
                                        <Border Style="{DynamicResource DiffTagNew}"
                                                Margin="0,0,10,0"
                                                Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="NEW"
                                                       Style="{DynamicResource DiffTextNew}"/>
                                        </Border>

                                        <!-- Arrow -->
                                        <TextBlock Text="→"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Margin="0,0,10,0"/>

                                        <!-- Corrected Word (Green) -->
                                        <Border Style="{DynamicResource DiffTagCorrected}">
                                            <TextBlock Text="{Binding CorrectedText}"
                                                       Style="{DynamicResource DiffTextCorrected}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- ===== EDIT MODE DISPLAY ===== -->
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}">

                                        <!-- Editable Original TextBox (red tinted) -->
                                        <TextBox Text="{Binding EditingOriginalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource DiffEditOriginalTextBox}"
                                                 AutomationProperties.Name="Heard correction text"
                                                 ToolTip="What the API heard (editable)"/>

                                        <!-- Arrow -->
                                        <TextBlock Text="→"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Margin="10,0"/>

                                        <!-- Editable Corrected TextBox (green tinted) -->
                                        <TextBox Text="{Binding EditingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource DiffEditTextBox}"
                                                 AutomationProperties.Name="Replacement correction text"
                                                 ToolTip="Correct spelling (editable)"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">

                                        <!-- Normal Mode: Edit + Remove -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisConverter}}">
                                            <Button Style="{DynamicResource DiffEditButton}"
                                                    AutomationProperties.Name="Edit detected correction"
                                                    Click="Edit_Click"
                                                    Tag="{Binding}"/>
                                            <Button Style="{DynamicResource DiffRemoveButton}"
                                                    AutomationProperties.Name="Remove detected correction"
                                                    Click="Remove_Click"
                                                    Tag="{Binding}"
                                                    Margin="4,0,0,0"/>
                                        </StackPanel>

                                        <!-- Edit Mode: Save + Cancel -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}">
                                            <Button Style="{DynamicResource DiffSaveButton}"
                                                    AutomationProperties.Name="Save detected correction edit"
                                                    Click="SaveEdit_Click"
                                                    Tag="{Binding}"/>
                                            <Button Style="{DynamicResource DiffRemoveButton}"
                                                    AutomationProperties.Name="Cancel detected correction edit"
                                                    Click="CancelEdit_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Cancel"
                                                    Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Skip All Button (Secondary) -->
                    <Button Grid.Column="0"
                            Content="Skip All"
                            Style="{DynamicResource BaseButton}"
                            AutomationProperties.Name="Skip all detected corrections"
                            Click="Skip_Click"/>

                    <!-- Add to Dictionary Button (Primary) -->
                    <Button Grid.Column="2"
                            Content="Add to Dictionary"
                            Style="{DynamicResource PrimaryButton}"
                            AutomationProperties.Name="Add selected corrections to dictionary"
                            Click="AddSelected_Click"
                            IsEnabled="{Binding HasItems}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
