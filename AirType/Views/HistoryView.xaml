<UserControl x:Class="AirType.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:AirType.ViewModels"
             xmlns:converters="clr-namespace:AirType.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance viewmodels:HistoryViewModel}">
    
    <UserControl.Resources>
        <converters:DaySeparatorVisibilityConverter x:Key="DaySeparatorVisibilityConverter"/>
        <converters:IsBeingEditedConverter x:Key="IsBeingEditedConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="0" Background="{DynamicResource BgBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- SECTION 1: Fixed Header (Border fills the gap with background) -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,28,32,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="History" Style="{DynamicResource PageTitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                    <TextBox Width="248"
                             Style="{DynamicResource SearchBox}"
                             materialDesign:HintAssist.Hint="Search history..."
                             AutomationProperties.Name="Search history"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SECTION 2: Scrollable Content -->
        <Grid Grid.Row="1">
            <!-- Sticky Day Catcher -->
            <Border x:Name="StickyHeader"
                    Margin="0,-1,0,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource BgBrush}"
                    Padding="32,12,32,12"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Panel.ZIndex="100"
                    IsHitTestVisible="False">
                <TextBlock x:Name="StickyHeaderText" 
                           Style="{DynamicResource SectionHeader}"
                           Margin="48,0,0,0"/>
            </Border>

            <ScrollViewer
                      x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="OnScrollChanged">
                <!-- Custom template with scrollbar margin to avoid overlap with sticky header -->
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Margin="0,48,0,0"
                                       Opacity="0"
                                       Style="{StaticResource MinimalVerticalScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </ScrollViewer.Template>
                
                <!-- Buffer Grid: Top margin (48) accounts for the StickyHeader height -->
                <Grid x:Name="HistoryTimelineHost"
                      Margin="32,48,32,48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/> <!-- Timeline Gutter -->
                        <ColumnDefinition Width="*"/>  <!-- Content -->
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="TimelineLine"
                               Grid.Column="0"
                               Width="2" 
                               HorizontalAlignment="Left"
                               VerticalAlignment="Stretch"
                               Margin="16,0,0,0"
                               Fill="{DynamicResource DividerBrush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasItems, ElementName=HistoryItemsControl, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="Black" Offset="0.8"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                <ItemsControl Grid.ColumnSpan="2"
                              x:Name="HistoryItemsControl"
                              ItemsSource="{Binding FilteredEntries}"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Transcription history"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Standard">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Visibility="{Binding IsFirstOfDay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Padding="0,16,0,16"
                                        Margin="48,0,0,16">
                                    <TextBlock Text="{Binding DateLabel}" 
                                             Style="{DynamicResource SectionHeader}"
                                             Tag="DaySeparator">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource DaySeparatorVisibilityConverter}">
                                                <Binding Path="DateLabel"/>
                                                <Binding Path="DataContext.CurrentDayInCatcher" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                <Binding Path="IsFirstOfDay"/>
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Style="{DynamicResource TimelineDot}"/>

                                    <Border Grid.Column="1"
                                            Style="{DynamicResource HistoryCard}"
                                            AutomationProperties.Name="{Binding Time, StringFormat='Transcript at {0}'}"
                                            AutomationProperties.HelpText="{Binding Preview}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                                <Border Style="{DynamicResource Badge}">
                                                    <TextBlock Text="{Binding Time}"
                                                             Style="{DynamicResource BadgeText}"/>
                                                </Border>

                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                                            Style="{DynamicResource IconButtonSubtle}"
                                                            Command="{Binding DataContext.CopyEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Copy"
                                                            AutomationProperties.Name="Copy transcript">
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15"/>
                                                    </Button>
                                                    <Button Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                                            Style="{DynamicResource IconButtonSubtle}"
                                                            Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanEditDisplayedTranscript}"
                                                            ToolTip="Edit"
                                                            AutomationProperties.Name="Edit transcript">
                                                        <Button.Visibility>
                                                            <MultiBinding Converter="{StaticResource IsBeingEditedConverter}" ConverterParameter="Inverse">
                                                                <Binding Path="Id"/>
                                                                <Binding Path="DataContext.EditingId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </Button.Visibility>
                                                        <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15"/>
                                                    </Button>
                                                    
                                                    <Button Padding="0" Width="28" Height="28"
                                                            Style="{DynamicResource IconButtonSubtle}"
                                                            Click="OnMoreClick"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            ToolTip="More options"
                                                            AutomationProperties.Name="Transcript options">
                                                        <Button.Visibility>
                                                            <MultiBinding Converter="{StaticResource IsBeingEditedConverter}" ConverterParameter="Inverse">
                                                                <Binding Path="Id"/>
                                                                <Binding Path="DataContext.EditingId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </Button.Visibility>
                                                        <Button.ContextMenu>
                                <ContextMenu Style="{DynamicResource CustomContextMenu}" DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Transcript options menu">
                                    <MenuItem Header="Rerun" AutomationProperties.Name="Rerun transcript" Style="{DynamicResource CustomMenuItem}" Command="{Binding RerunCommand}" CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Download Audio" AutomationProperties.Name="Download transcript audio" Style="{DynamicResource CustomMenuItem}" Command="{Binding DownloadAudioCommand}" CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{Binding Path=PlacementTarget.DataContext.TranscriptDisplayToggleHeader, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              AutomationProperties.Name="{Binding Path=PlacementTarget.DataContext.TranscriptDisplayToggleAutomationName, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Style="{DynamicResource CustomMenuItem}"
                                              Command="{Binding ToggleTranscriptDisplayCommand}"
                                              CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding Path=PlacementTarget.DataContext.CanToggleTranscriptDisplay, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Separator Style="{StaticResource CustomSeparator}"/>
                                    <MenuItem Header="Delete" AutomationProperties.Name="Delete transcript" Style="{DynamicResource CustomMenuItem}" Foreground="{DynamicResource ErrorBrush}" Command="{Binding DeleteEntryCommand}" CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <materialDesign:PackIcon Kind="DotsVertical" Width="18" Height="18"/>
                                                    </Button>
                                                </StackPanel>
                                            </DockPanel>

                                            <Grid Margin="0,0,0,14">
                                                <!-- Normal View: TextBlock -->
                                                <TextBlock Text="{Binding Body}" 
                                                         Style="{DynamicResource CardBody}"
                                                         TextWrapping="Wrap">
                                                    <TextBlock.Visibility>
                                                        <MultiBinding Converter="{StaticResource IsBeingEditedConverter}" ConverterParameter="Inverse">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="DataContext.EditingId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Visibility>
                                                </TextBlock>

                                                <!-- Edit View: TextBox + Save/Cancel -->
                                                <StackPanel>
                                                    <StackPanel.Visibility>
                                                        <MultiBinding Converter="{StaticResource IsBeingEditedConverter}">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="DataContext.EditingId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </StackPanel.Visibility>
                                                    
                                                    <TextBox Style="{DynamicResource CustomTextArea}"
                                                             Height="Auto"
                                                             MinHeight="80"
                                                             MaxHeight="300"
                                                             Margin="0,0,0,12"
                                                             AutomationProperties.Name="Transcript edit text"
                                                             Text="{Binding DataContext.EditingText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>
                                                    
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Save" 
                                                                Style="{DynamicResource PrimaryButton}" 
                                                                Margin="0,0,8,0"
                                                                Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Cancel" 
                                                                Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="WORDS" Style="{DynamicResource InlineMetaLabel}"/>
                                                        <TextBlock Text="{Binding Words}" Style="{DynamicResource InlineMetaValue}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                                        <materialDesign:PackIcon Kind="ClockOutline"
                                                                                 Width="13"
                                                                                 Height="13"
                                                                                 Margin="0,0,6,0"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                                 ToolTip="Duration"
                                                                                 AutomationProperties.Name="Duration"/>
                                                        <TextBlock Text="{Binding Duration}" Style="{DynamicResource InlineMetaValue}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Style="{DynamicResource HistoryMetaBadge}" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Microphone"
                                                                                         Width="13"
                                                                                         Height="13"
                                                                                         Margin="0,0,6,0"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{DynamicResource TextMutedBrush}"
                                                                                         ToolTip="Speech engine"
                                                                                         AutomationProperties.Name="Speech engine"/>
                                                                <TextBlock Style="{DynamicResource HistoryMetaValue}" Text="{Binding SpeechEngineDisplay}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{DynamicResource HistoryMetaBadge}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="AutoFix"
                                                                                         Width="13"
                                                                                         Height="13"
                                                                                         Margin="0,0,6,0"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{DynamicResource TextMutedBrush}"
                                                                                         ToolTip="Cleaner"
                                                                                         AutomationProperties.Name="Cleaner"/>
                                                                <TextBlock Style="{DynamicResource HistoryMetaValue}" Text="{Binding CleanerDisplay}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,160,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=HistoryItemsControl}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="No history yet"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Transcriptions will appear here"
                               Style="{DynamicResource BodyText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
