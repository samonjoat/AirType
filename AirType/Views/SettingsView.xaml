<UserControl x:Class="AirType.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:AirType.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AirType.Controls"
             xmlns:viewmodels="clr-namespace:AirType.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="980"
             d:DataContext="{d:DesignInstance viewmodels:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:ApiKeyStatusDisplayConverter x:Key="ApiKeyStatusDisplayConverter"/>
        <conv:ApiKeyStatusKindConverter x:Key="ApiKeyStatusKindConverter"/>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SettingsCardHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="SettingsIconBox" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="{DynamicResource BgMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>

        <Style x:Key="SettingsMutedValue" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ApiStatusBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="{DynamicResource BgMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource ApiKeyStatusKindConverter}}" Value="Connected">
                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource ApiKeyStatusKindConverter}}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource ApiKeyStatusKindConverter}}" Value="NotConfigured">
                    <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ApiStatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource ApiKeyStatusKindConverter}}" Value="Connected">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource ApiKeyStatusKindConverter}}" Value="Error">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource ApiKeyStatusKindConverter}}" Value="NotConfigured">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ApiStatusText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource ApiKeyStatusKindConverter}}" Value="Connected">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource ApiKeyStatusKindConverter}}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource ApiKeyStatusKindConverter}}" Value="NotConfigured">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OfflineEngineStatusBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="{DynamicResource BgMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OfflineEngineStatusKind}" Value="Installed">
                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OfflineEngineStatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OfflineEngineStatusKind}" Value="Installed">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OfflineEngineStatusKind}" Value="NeedsAttention">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OfflineEngineStatusText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OfflineEngineStatusKind}" Value="Installed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OfflineEngineStatusKind}" Value="NeedsAttention">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ModelComboBoxItemTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       ToolTip="{Binding DisplayName}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,24,30,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Settings" Style="{DynamicResource PageTitle}"/>
                    <TextBlock Text="Everything on one surface - no tabs to hunt through"
                               Style="{DynamicResource BodyText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Style="{DynamicResource MinimalScrollViewer}">
            <controls:MasonryPanel Margin="28,20,30,28"
                                   MinColumnWidth="420"
                                   ColumnSpacing="18"
                                   RowSpacing="18"
                                   MaxColumns="2">

                <!-- Audio and input -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{DynamicResource SettingsCardHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource SettingsIconBox}">
                                    <materialDesign:PackIcon Kind="Microphone" Width="14" Height="14"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Audio &amp; Input"
                                           Style="{DynamicResource PageHeader}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="16">
                            <TextBlock Text="Microphone" Style="{DynamicResource FieldLabel}"/>
                            <ComboBox SelectedItem="{Binding SelectedMicrophone}"
                                      ItemsSource="{Binding AudioDevices}"
                                      AutomationProperties.Name="Microphone"
                                      Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid Visibility="{Binding IsHotkeyEditMode, Converter={StaticResource InverseBoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Global hotkey" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{DynamicResource Badge}"
                                            Padding="10,4"
                                            Margin="0,0,8,0"
                                            AutomationProperties.Name="{Binding CurrentHotkeyDisplay, StringFormat=Global hotkey {0}}">
                                        <TextBlock Text="{Binding CurrentHotkeyDisplay}" Style="{DynamicResource BadgeText}"/>
                                    </Border>
                                    <Button Content="Change"
                                            Height="30"
                                            Padding="12,0"
                                            AutomationProperties.Name="Change global hotkey"
                                            Command="{Binding StartHotkeyEditCommand}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsHotkeyEditMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Record new hotkey" Style="{DynamicResource FieldLabel}"/>
                                <TextBox x:Name="HotkeyCaptureTextBox"
                                         Text="{Binding PendingHotkeyDisplay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Height="48"
                                         Focusable="True"
                                         AutomationProperties.Name="Record new hotkey"
                                         Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Save" AutomationProperties.Name="Save hotkey" Style="{DynamicResource PrimaryButton}" Command="{Binding SaveHotkeyCommand}"/>
                                    <Button Grid.Column="2" Content="Clear" AutomationProperties.Name="Clear hotkey" Command="{Binding ClearHotkeyCommand}" Click="ClearHotkey_Click"/>
                                    <Button Grid.Column="4" Content="Cancel" AutomationProperties.Name="Cancel hotkey edit" Command="{Binding CancelHotkeyEditCommand}"/>
                                </Grid>
                            </StackPanel>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mute audio while recording" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1"
                                          Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding MuteSystemAudioDuringRecording}"
                                          AutomationProperties.Name="Mute audio while recording"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Transcription -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{DynamicResource SettingsCardHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource SettingsIconBox}">
                                    <materialDesign:PackIcon Kind="FormatAlignLeft" Width="14" Height="14"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Transcription"
                                           Style="{DynamicResource PageHeader}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Speech engine" Style="{DynamicResource FieldLabel}"/>
                                    <ComboBox SelectedItem="{Binding SelectedProvider}"
                                              ItemsSource="{Binding Providers}"
                                              AutomationProperties.Name="Speech engine"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Speech model" Style="{DynamicResource FieldLabel}"/>
                                    <ComboBox SelectedValue="{Binding SelectedModel}"
                                              ItemsSource="{Binding AvailableModels}"
                                              ItemTemplate="{StaticResource ModelComboBoxItemTemplate}"
                                              SelectedValuePath="Id"
                                              AutomationProperties.Name="Speech model"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Offline engine" Style="{DynamicResource FieldLabel}" Margin="0,0,10,0"/>
                                    <Border Style="{DynamicResource OfflineEngineStatusBadge}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{DynamicResource OfflineEngineStatusDot}"/>
                                            <TextBlock Text="{Binding OfflineEngineStatus}" Style="{DynamicResource OfflineEngineStatusText}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{Binding OfflineEngineInstallActionText}"
                                            Height="30"
                                            Padding="12,0"
                                            Margin="0,0,6,0"
                                            Style="{DynamicResource PrimaryButton}"
                                            Command="{Binding InstallOfflineEngineCommand}"
                                            IsEnabled="{Binding CanInstallOfflineEngine}"
                                            AutomationProperties.Name="Download offline engine"
                                            Visibility="{Binding ShowOfflineEngineInstallAction, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Cancel"
                                            Height="30"
                                            Padding="9,0"
                                            Margin="0,0,6,0"
                                            Command="{Binding CancelOfflineEngineInstallCommand}"
                                            IsEnabled="{Binding CanCancelOfflineEngineInstall}"
                                            AutomationProperties.Name="Cancel offline engine install"
                                            Visibility="{Binding ShowOfflineEngineCancelAction, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Folder"
                                            Height="30"
                                            Padding="9,0"
                                            Margin="0,0,6,0"
                                            Command="{Binding OpenOfflineEngineFolderCommand}"
                                            AutomationProperties.Name="Open offline engine folder"
                                            Visibility="{Binding ShowOfflineEngineFolderAction, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Remove"
                                            Height="30"
                                            Padding="9,0"
                                            Style="{DynamicResource DangerButton}"
                                            Command="{Binding RemoveOfflineEngineCommand}"
                                            IsEnabled="{Binding CanUseOfflineEngineActions}"
                                            AutomationProperties.Name="Remove offline engine"
                                            Visibility="{Binding ShowOfflineEngineRemoveAction, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>

                            <ProgressBar Value="{Binding OfflineEngineInstallProgress}"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,12,0,4"
                                         AutomationProperties.Name="Offline engine install progress"
                                         Visibility="{Binding IsOfflineEngineInstalling, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding OfflineEngineInstallProgressText}"
                                       Style="{DynamicResource SettingsMutedValue}"
                                       Visibility="{Binding IsOfflineEngineInstalling, Converter={StaticResource BoolToVis}}"/>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Clean up transcript" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1"
                                          Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding IsTranscriptCleanupEnabled}"
                                          AutomationProperties.Name="Clean up transcript"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox SelectedItem="{Binding SelectedCleanupProvider}"
                                          ItemsSource="{Binding CleanupProviders}"
                                          AutomationProperties.Name="Cleanup provider"
                                          IsEnabled="{Binding CanUseCleanupSelection}"/>
                                <ComboBox Grid.Column="2"
                                          SelectedValue="{Binding SelectedCleanupModel}"
                                          ItemsSource="{Binding AvailableCleanupModels}"
                                          ItemTemplate="{StaticResource ModelComboBoxItemTemplate}"
                                          SelectedValuePath="Id"
                                          AutomationProperties.Name="Cleanup model"
                                          IsEnabled="{Binding CanUseCleanupSelection}"/>
                            </Grid>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Context mode" Style="{DynamicResource FieldLabel}"/>
                                    <ComboBox SelectedItem="{Binding SelectedCleanupContextMode}"
                                              ItemsSource="{Binding CleanupContextModes}"
                                              AutomationProperties.Name="Cleanup context mode"
                                              IsEnabled="{Binding CanUseCleanupSelection}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Intensity" Style="{DynamicResource FieldLabel}"/>
                                    <Border Style="{DynamicResource SegmentedControlRail}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Light"
                                                         GroupName="CleanupIntensity"
                                                         Style="{DynamicResource TabRadioButton}"
                                                         AutomationProperties.Name="Light cleanup intensity"
                                                         IsChecked="{Binding SelectedCleanupIntensity, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Light}"
                                                         IsEnabled="{Binding CanUseCleanupSelection}"/>
                                            <RadioButton Content="Standard"
                                                         GroupName="CleanupIntensity"
                                                         Style="{DynamicResource TabRadioButton}"
                                                         AutomationProperties.Name="Standard cleanup intensity"
                                                         IsChecked="{Binding SelectedCleanupIntensity, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Standard}"
                                                         IsEnabled="{Binding CanUseCleanupSelection}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default format" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Style="{DynamicResource SegmentedControlRail}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Plain"
                                                     GroupName="FormattingMode"
                                                     Style="{DynamicResource TabRadioButton}"
                                                     AutomationProperties.Name="Plain formatting"
                                                     IsChecked="{Binding FormattingMode, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Plain Text}"/>
                                        <RadioButton Content="Markdown"
                                                     GroupName="FormattingMode"
                                                     Style="{DynamicResource TabRadioButton}"
                                                     AutomationProperties.Name="Markdown formatting"
                                                     IsChecked="{Binding FormattingMode, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Markdown}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- API keys -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{DynamicResource SettingsCardHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource SettingsIconBox}">
                                    <materialDesign:PackIcon Kind="KeyVariant" Width="14" Height="14"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="API Keys"
                                           Style="{DynamicResource PageHeader}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gemini" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Style="{DynamicResource ApiStatusBadge}"
                                        DataContext="{Binding GeminiStatus}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{DynamicResource ApiStatusDot}"/>
                                        <TextBlock Text="{Binding Converter={StaticResource ApiKeyStatusDisplayConverter}}"
                                                   Style="{DynamicResource ApiStatusText}"/>
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="GeminiApiKeyPasswordBox" AutomationProperties.Name="Gemini API key" PasswordChanged="GeminiApiKeyPasswordBox_PasswordChanged"/>
                                    <Button Grid.Column="2" Content="Save" AutomationProperties.Name="Save Gemini API key" Style="{DynamicResource PrimaryButton}" Height="32" Padding="10,0" Command="{Binding SaveApiKeyCommand}"/>
                                    <Button Grid.Column="4" Content="Test" AutomationProperties.Name="Test Gemini connection" Height="32" Padding="10,0" Command="{Binding TestConnectionCommand}" CommandParameter="Gemini"/>
                                </Grid>
                            </Grid>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="OpenRouter" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Style="{DynamicResource ApiStatusBadge}"
                                        DataContext="{Binding OpenRouterStatus}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{DynamicResource ApiStatusDot}"/>
                                        <TextBlock Text="{Binding Converter={StaticResource ApiKeyStatusDisplayConverter}}"
                                                   Style="{DynamicResource ApiStatusText}"/>
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="OpenRouterApiKeyPasswordBox" AutomationProperties.Name="OpenRouter API key" PasswordChanged="OpenRouterApiKeyPasswordBox_PasswordChanged"/>
                                    <Button Grid.Column="2" Content="Save" AutomationProperties.Name="Save OpenRouter API key" Style="{DynamicResource PrimaryButton}" Height="32" Padding="10,0" Command="{Binding SaveApiKeyCommand}"/>
                                    <Button Grid.Column="4" Content="Test" AutomationProperties.Name="Test OpenRouter connection" Height="32" Padding="10,0" Command="{Binding TestConnectionCommand}" CommandParameter="OpenRouter"/>
                                </Grid>
                            </Grid>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Groq" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Style="{DynamicResource ApiStatusBadge}"
                                        DataContext="{Binding GroqStatus}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{DynamicResource ApiStatusDot}"/>
                                        <TextBlock Text="{Binding Converter={StaticResource ApiKeyStatusDisplayConverter}}"
                                                   Style="{DynamicResource ApiStatusText}"/>
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="GroqApiKeyPasswordBox" AutomationProperties.Name="Groq API key" PasswordChanged="GroqApiKeyPasswordBox_PasswordChanged"/>
                                    <Button Grid.Column="2" Content="Save" AutomationProperties.Name="Save Groq API key" Style="{DynamicResource PrimaryButton}" Height="32" Padding="10,0" Command="{Binding SaveApiKeyCommand}"/>
                                    <Button Grid.Column="4" Content="Test" AutomationProperties.Name="Test Groq connection" Height="32" Padding="10,0" Command="{Binding TestConnectionCommand}" CommandParameter="Groq"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Prompts -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{DynamicResource SettingsCardHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource SettingsIconBox}">
                                    <materialDesign:PackIcon Kind="TextBoxMultipleOutline" Width="14" Height="14"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Prompts"
                                           Style="{DynamicResource PageHeader}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="16">
                            <TextBlock Text="Style override" Style="{DynamicResource FieldLabel}"/>
                            <ComboBox SelectedItem="{Binding SelectedProfile}"
                                      ItemsSource="{Binding Profiles}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.Name="Cleanup style override"
                                      Margin="0,0,0,14">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource CustomComboBoxItem}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="Create New...">
                                                <Setter Property="Tag" Value="Last"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock Text="Name" Style="{DynamicResource FieldLabel}" Visibility="{Binding IsNameFieldVisible, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Text="{Binding PromptName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14"
                                     IsEnabled="{Binding IsProfileEditable}"
                                     AutomationProperties.Name="Prompt profile name"
                                     Visibility="{Binding IsNameFieldVisible, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="System prompt" Style="{DynamicResource FieldLabel}"/>
                            <TextBox Style="{DynamicResource CustomTextArea}"
                                     Height="96"
                                     Margin="0,0,0,14"
                                     Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="System prompt"
                                     IsReadOnly="{Binding IsProfileEditable, Converter={StaticResource BooleanInverterConverter}}">
                                <TextBox.Resources>
                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource MinimalScrollViewer}"/>
                                </TextBox.Resources>
                            </TextBox>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save"
                                        Style="{DynamicResource PrimaryButton}"
                                        Margin="0,0,8,0"
                                        Command="{Binding SaveProfileCommand}"
                                        AutomationProperties.Name="Save prompt profile"
                                        Visibility="{Binding IsSaveVisible, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Duplicate"
                                        Margin="0,0,8,0"
                                        Command="{Binding DuplicateProfileCommand}"
                                        AutomationProperties.Name="Duplicate prompt profile"
                                        Visibility="{Binding IsDuplicateVisible, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Delete"
                                        Style="{DynamicResource DangerButton}"
                                        Command="{Binding DeleteProfileCommand}"
                                        AutomationProperties.Name="Delete prompt profile"
                                        Visibility="{Binding IsDeleteVisible, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Diagnostics -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{DynamicResource SettingsCardHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource SettingsIconBox}">
                                    <materialDesign:PackIcon Kind="Pulse" Width="14" Height="14"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Diagnostics"
                                           Style="{DynamicResource PageHeader}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API latency - last 10" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AverageLatency}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <controls:LatencyChart ItemsSource="{Binding LatencyData}" Height="40" Margin="0,0,0,18"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="System info" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Copy"
                                        Height="28"
                                        Padding="9,0"
                                        AutomationProperties.Name="Copy system info"
                                        Command="{Binding CopySystemInfoCommand}"/>
                            </Grid>

                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource FieldCornerRadius}"
                                    Padding="10"
                                    Height="86"
                                    AutomationProperties.Name="System info"
                                    Margin="0,0,0,18">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Style="{DynamicResource MinimalScrollViewer}">
                                    <TextBlock Text="{Binding SystemInfo}"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Recent logs" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Open" AutomationProperties.Name="Refresh recent logs" Height="28" Padding="9,0" Command="{Binding RefreshLogsCommand}"/>
                            </Grid>

                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource FieldCornerRadius}"
                                    Padding="10"
                                    AutomationProperties.Name="Recent logs"
                                    Height="78">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource MinimalScrollViewer}">
                                    <ItemsControl ItemsSource="{Binding LogEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Timestamp}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="INFO"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="SUCCESS"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- General -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <Border Style="{DynamicResource SettingsCardHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource SettingsIconBox}">
                                    <materialDesign:PackIcon Kind="CogOutline" Width="14" Height="14"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="General"
                                           Style="{DynamicResource PageHeader}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Audio retention" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          SelectedItem="{Binding StorageRetention}"
                                          AutomationProperties.Name="Audio retention"
                                          ItemsSource="{Binding RetentionPeriods}"/>
                            </Grid>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Launch on startup" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1"
                                          Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding LaunchOnStartup}"
                                          AutomationProperties.Name="Launch on startup"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Minimize to tray on close" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1"
                                          Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding MinimizeToTray}"
                                          AutomationProperties.Name="Minimize to tray on close"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Smart insertion" Style="{DynamicResource FieldLabel}"/>
                                    <TextBlock Text="Context-aware spacing and capitalization"
                                               Style="{DynamicResource SettingsMutedValue}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding EnableSmartInsertion}"
                                          AutomationProperties.Name="Smart insertion context-aware spacing and capitalization"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Native typing fallback" Style="{DynamicResource FieldLabel}"/>
                                    <TextBlock Text="Default fallback when fields reject clipboard paste"
                                               Style="{DynamicResource SettingsMutedValue}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding EnableNativeTypingInjection}"
                                          AutomationProperties.Name="Native typing fallback default on"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Border Style="{DynamicResource SettingsDivider}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Reset all settings" Style="{DynamicResource FieldLabel}"/>
                                    <TextBlock Text="Restore defaults" Style="{DynamicResource SettingsMutedValue}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Reset"
                                        Style="{DynamicResource DangerButton}"
                                        Height="30"
                                        Padding="10,0"
                                        AutomationProperties.Name="Reset all settings"
                                        IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </controls:MasonryPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
