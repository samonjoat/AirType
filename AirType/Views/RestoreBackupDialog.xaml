<Window x:Class="AirType.Views.RestoreBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Database Not Found"
        Width="400" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        AutomationProperties.Name="Restore backup dialog"
        Style="{DynamicResource GlobalModalWindow}">

    <Border Style="{DynamicResource ModalCard}" Margin="20">
        <Grid>
            <!-- Close Button (Top Right) -->
            <Button Style="{DynamicResource ModalCloseButton}"
                    AutomationProperties.Name="Close restore backup dialog"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12"
                    Click="Close_Click"
                    Panel.ZIndex="1"/>

            <StackPanel Margin="24">
                <!-- Icon -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                <!-- Background Circle (Faint) -->
                <Border Width="56" Height="56"
                        CornerRadius="28"
                        Background="{DynamicResource AccentBrush}"
                        Opacity="0.15"/>
                
                <!-- Icon (Solid) -->
                <Path Data="M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z"
                      Fill="{DynamicResource TextPrimaryBrush}"
                      Stretch="Uniform"
                      Width="28" Height="28"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Grid>

            <!-- Title -->
            <TextBlock Text="Database Not Found"
                       Style="{DynamicResource PageHeader}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- Message -->
            <TextBlock Text="Your previous data was backed up. Would you like to restore it?"
                       Style="{DynamicResource BodyText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Backup Detail -->
            <TextBlock x:Name="BackupDateText"
                       Text="Backup from: --"
                       Style="{DynamicResource BodyText}"
                       FontSize="13"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Opacity="0.8"
                       Margin="0,0,0,24"/>

            <!-- Action Buttons -->
            <StackPanel>
                <!-- Restore Button (Primary) -->
                <Button x:Name="RestoreButton"
                        Content="Restore My Data"
                        Style="{DynamicResource PrimaryButton}"
                        AutomationProperties.Name="Restore my data"
                        Click="Restore_Click"
                        Margin="0,0,0,10"/>

                <!-- Start Fresh Button (Secondary) -->
                <Button x:Name="StartFreshButton"
                        Content="Start Fresh"
                        Style="{DynamicResource BaseButton}"
                        AutomationProperties.Name="Start fresh without backup"
                        Click="StartFresh_Click"/>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Window>
