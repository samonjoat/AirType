<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:media="clr-namespace:System.Windows.Media.Imaging;assembly=PresentationCore">
    
    <!-- Light Theme Colors - Slate Graphite Accent Refined -->
    <media:BitmapImage x:Key="AppLogoImage" UriSource="pack://application:,,,/AirType;component/Assets/Logo/airtype-logo-light.png"/>

    <SolidColorBrush x:Key="BgBrush" Color="#F4F0E9"/>
    <SolidColorBrush x:Key="BgPanelBrush" Color="#FBF8F2"/>
    <SolidColorBrush x:Key="BgMutedBrush" Color="#EAE4D9"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#211E19"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#141414"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E665B"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5F554A"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#9A9082"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DBD4C8"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFC6B8"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#8A8175"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#DBD4C8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4860FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#263DCC"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#4860FF" Opacity="0.12"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#141414" Opacity="0.08"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="#141414"/>
    <SolidColorBrush x:Key="LogoMarkBackgroundBrush" Color="#141414"/>
    <SolidColorBrush x:Key="LogoMarkForegroundBrush" Color="#FBF8F2"/>
    <SolidColorBrush x:Key="TimelineDotBrush" Color="#4860FF"/>
    <SolidColorBrush x:Key="ChartAccentBrush" Color="#4860FF"/>
    <SolidColorBrush x:Key="LatencyBarBrush" Color="#4860FF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F9A825"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#C62828" Opacity="0.10"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#2E7D32" Opacity="0.10"/>
    <SolidColorBrush x:Key="HeroPanelBrush" Color="#211E19"/>
    <SolidColorBrush x:Key="HeroTextBrush" Color="#FBF8F2"/>
    <SolidColorBrush x:Key="HeroMutedBrush" Color="#A89E8F"/>
    <SolidColorBrush x:Key="HeroDividerBrush" Color="#38322B"/>
    
    <!-- Dimensions -->
    <sys:Double x:Key="TopNavHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">48</sys:Double>
    <sys:Double x:Key="SidebarExpandedWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">220</sys:Double>
    <sys:Double x:Key="SidebarCollapsedWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">64</sys:Double>
    <GridLength x:Key="WindowFooterHeight">14</GridLength>
    
    <!-- Corner Radius -->
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="FieldCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="SelectCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="WaveCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="AppIconCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="ModalCornerRadius">14</CornerRadius>
    
    <!-- Spacing -->
    <Thickness x:Key="PagePadding">32,28,32,24</Thickness>
    <Thickness x:Key="CardPadding">18,15</Thickness>
    
    <!-- Modal -->
    <SolidColorBrush x:Key="ModalBackgroundBrush" Color="#000000" Opacity="0.4"/>

    <!-- Streak fire treatment -->
    <LinearGradientBrush x:Key="StreakFireBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF7ED" Offset="0"/>
        <GradientStop Color="#FFEDD5" Offset="0.28"/>
        <GradientStop Color="#FED7AA" Offset="0.58"/>
        <GradientStop Color="#F97316" Offset="0.82"/>
        <GradientStop Color="#9A3412" Offset="1"/>
    </LinearGradientBrush>

    <!-- Shadows -->
    <DropShadowEffect x:Key="PanelShadow"
                      Color="#000000"
                      Opacity="0.07"
                      BlurRadius="28"
                      ShadowDepth="12"
                      Direction="270"/>

    <!-- Modal Shadow (35% for light theme - balanced visibility, centered for even depth) -->
    <DropShadowEffect x:Key="ModalShadow"
                      Color="#000000"
                      Opacity="0.35"
                      BlurRadius="32"
                      ShadowDepth="0"
                      Direction="270"/>

    <!-- Elevation System -->
    <DropShadowEffect x:Key="Elevation1" Color="#000000" Opacity="0.04" BlurRadius="8" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="Elevation2" Color="#000000" Opacity="0.08" BlurRadius="22" ShadowDepth="8" Direction="270"/>
    <DropShadowEffect x:Key="WindowShadow" Color="#000000" Opacity="0.14" BlurRadius="34" ShadowDepth="0" Direction="270"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#DBD4C8"/>

</ResourceDictionary>
