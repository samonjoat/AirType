<UserControl x:Class="AirType.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AirType.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="980">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style x:Key="MilestoneCard" TargetType="Border" BasedOn="{StaticResource StatCard}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,28,32,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Statistics" Style="{DynamicResource PageTitle}"/>
                    <TextBlock Text="{Binding MemberSince}"
                               Style="{DynamicResource BodyText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{DynamicResource SegmentedControlRail}"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Today" Style="{DynamicResource TabRadioButton}" GroupName="DateFilter"
                                     AutomationProperties.Name="Show today's statistics"
                                     Command="{Binding SelectPeriodCommand}" CommandParameter="Today"/>
                        <RadioButton Content="Week" Style="{DynamicResource TabRadioButton}" GroupName="DateFilter"
                                     AutomationProperties.Name="Show this week's statistics"
                                     Command="{Binding SelectPeriodCommand}" CommandParameter="This Week"/>
                        <RadioButton Content="Month" Style="{DynamicResource TabRadioButton}" GroupName="DateFilter"
                                     AutomationProperties.Name="Show this month's statistics"
                                     Command="{Binding SelectPeriodCommand}" CommandParameter="This Month"/>
                        <RadioButton Content="All time" Style="{DynamicResource TabRadioButton}" GroupName="DateFilter" IsChecked="True"
                                     AutomationProperties.Name="Show all time statistics"
                                     Command="{Binding SelectPeriodCommand}" CommandParameter="All Time"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{DynamicResource MinimalScrollViewer}">
            <StackPanel Margin="32,22,32,28">
                <Border Background="{DynamicResource HeroPanelBrush}"
                        CornerRadius="16"
                        Padding="26,24"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="TOTAL WORDS DICTATED"
                                       Foreground="{DynamicResource HeroMutedBrush}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalWords}"
                                       Foreground="{DynamicResource HeroTextBrush}"
                                       FontSize="42"
                                       FontWeight="SemiBold"
                                       LineHeight="42"/>
                            <TextBlock Text="{Binding BookEquivalent}"
                                       Foreground="{DynamicResource HeroMutedBrush}"
                                       Style="{DynamicResource SmallText}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{DynamicResource HeroDividerBrush}"/>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="30,0,0,0">
                            <StackPanel Margin="0,0,34,0">
                                <TextBlock Text="Time saved"
                                           Foreground="{DynamicResource HeroMutedBrush}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TimeSavedHours}"
                                           Foreground="{DynamicResource HeroTextBrush}"
                                           FontSize="26"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Speaking pace"
                                           Foreground="{DynamicResource HeroMutedBrush}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding WordsPerMinute}"
                                           Foreground="{DynamicResource HeroTextBrush}"
                                           FontSize="26"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource StreakFireBrush}"
                            BorderBrush="#F97316"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Fire"
                                                         Width="16" Height="16"
                                                         Foreground="#9A3412"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Current streak" Foreground="#9A3412" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentStreak}" Foreground="#C2410C" FontSize="26" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Days used" Style="{DynamicResource FieldLabel}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding DaysUsed}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="26" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="This week" Style="{DynamicResource FieldLabel}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ThisWeekWords}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="26" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Avg / day" Style="{DynamicResource FieldLabel}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding AvgWordsPerDay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="26" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource StatCard}" Margin="0,0,0,18" Padding="20,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Words dictated"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="last 30 days"
                                       HorizontalAlignment="Right"
                                       Style="{DynamicResource SmallText}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>

                        <controls:WordActivityLineChart ItemsSource="{Binding WordActivityData}" Height="108"/>

                        <Border BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,9,0,0"
                                Margin="0,14,0,0">
                            <Grid>
                                <TextBlock Text="{Binding WordActivityStartLabel}" Style="{DynamicResource SmallText}" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding WordActivitySummary}" Style="{DynamicResource SmallText}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding WordActivityEndLabel}" Style="{DynamicResource SmallText}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="MILESTONES" Style="{DynamicResource SectionHeader}" Margin="0,2,0,11"/>

                <controls:FlexWrapPanel MinItemWidth="148" ItemSpacing="14" RowSpacing="14">
                    <Border Style="{StaticResource MilestoneCard}">
                        <Border.Opacity>
                            <Binding Path="AchievementFirstWords" Converter="{StaticResource BooleanToOpacityConverter}"/>
                        </Border.Opacity>
                        <StackPanel>
                            <TextBlock Text="1,000 words" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AchievementFirstWordsStatus}" Style="{DynamicResource SmallText}" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MilestoneCard}">
                        <Border.Opacity>
                            <Binding Path="AchievementTenK" Converter="{StaticResource BooleanToOpacityConverter}"/>
                        </Border.Opacity>
                        <StackPanel>
                            <TextBlock Text="10,000 words" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AchievementTenKStatus}" Style="{DynamicResource SmallText}" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MilestoneCard}">
                        <Border.Opacity>
                            <Binding Path="AchievementTwentyFiveK" Converter="{StaticResource BooleanToOpacityConverter}"/>
                        </Border.Opacity>
                        <StackPanel>
                            <TextBlock Text="25,000 words" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AchievementTwentyFiveKStatus}" Style="{DynamicResource SmallText}" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MilestoneCard}">
                        <Border.Opacity>
                            <Binding Path="AchievementFiftyK" Converter="{StaticResource BooleanToOpacityConverter}"/>
                        </Border.Opacity>
                        <StackPanel>
                            <TextBlock Text="50,000 words" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AchievementFiftyKStatus}" Style="{DynamicResource SmallText}" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MilestoneCard}">
                        <Border.Opacity>
                            <Binding Path="AchievementHundredK" Converter="{StaticResource BooleanToOpacityConverter}"/>
                        </Border.Opacity>
                        <StackPanel>
                            <TextBlock Text="100,000 words" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AchievementHundredKStatus}" Style="{DynamicResource SmallText}" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </controls:FlexWrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
